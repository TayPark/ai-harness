{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric.schema.json",
  "title": "Project Evaluation Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_id", "version", "score_scale", "passing_threshold", "score_guide", "target_types"],
  "properties": {
    "rubric_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "score_scale": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"const": 0}, "max": {"const": 4}}},
    "passing_threshold": {"type": "number", "minimum": 0, "maximum": 100},
    "score_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4"],
      "properties": {
        "0": {"type": "string", "minLength": 1},
        "1": {"type": "string", "minLength": 1},
        "2": {"type": "string", "minLength": 1},
        "3": {"type": "string", "minLength": 1},
        "4": {"type": "string", "minLength": 1}
      }
    },
    "target_types": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,31}$": {"$ref": "#/$defs/targetType"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weight", "applicability", "criterion", "required_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
        "name": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 1, "maximum": 100},
        "applicability": {"enum": ["required", "optional"]},
        "criterion": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "string", "minLength": 1}
      }
    },
    "criticalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "applicability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
        "description": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["required", "optional"]}
      }
    },
    "targetType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "critical_conditions"],
      "properties": {
        "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
        "critical_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criticalCondition"}}
      }
    }
  }
}
