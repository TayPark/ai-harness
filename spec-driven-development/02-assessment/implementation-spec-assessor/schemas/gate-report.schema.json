{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdd-v0.2/gate-report.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "format": "uuid"
    },
    "report_id": {
      "type": "string"
    },
    "gate_name": {
      "enum": [
        "SPECIFICATION_ASSESSMENT",
        "PLAN_ASSESSMENT",
        "AGENT_EXECUTION",
        "INDEPENDENT_VERIFICATION",
        "RELEASE_READINESS"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash_method": {
      "const": "stdlib-json-v1-no-report_hash"
    },
    "assessor_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "IN_PROGRESS",
        "NEEDS_REVISION",
        "READY",
        "PASS",
        "BLOCKED",
        "FAIL",
        "NOT_REQUIRED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requirement_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^R-[0-9]{2}$"
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verification_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^V-[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "requirement_id",
          "acceptance_ids",
          "task_ids",
          "verification_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R-[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "N_A_WITH_RATIONALE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "check_id",
          "requirement_ids",
          "criterion",
          "status",
          "evidence_ids",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "REPORT",
              "TRACE",
              "CHECKPOINT",
              "TEST",
              "DIFF",
              "SCAN",
              "MANUAL",
              "RELEASE"
            ]
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:[/\\\\])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "N_A_WITH_RATIONALE"
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "evidence_id",
          "kind",
          "relative_path",
          "sha256",
          "result",
          "captured_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "category": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R-[0-9]{2}$"
            },
            "minItems": 0
          },
          "summary": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "disposition": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "ACCEPTED_N_A"
            ]
          },
          "owner_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "finding_id",
          "severity",
          "category",
          "requirement_ids",
          "summary",
          "evidence_ids",
          "disposition",
          "owner_role"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "error_id": {
            "type": "string"
          },
          "code": {
            "enum": [
              "SCHEMA_INVALID",
              "HASH_MISMATCH",
              "TRACEABILITY_INVALID",
              "SANDBOX_UNAVAILABLE",
              "SANDBOX_UNVERIFIED",
              "TOOL_FAILED",
              "EVIDENCE_MISSING",
              "SOURCE_CHANGED",
              "PRIVACY_VIOLATION",
              "REMOTE_CONFLICT",
              "OTHER"
            ]
          },
          "message": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "retryable": {
            "type": "boolean"
          },
          "blocked_gate": {
            "anyOf": [
              {
                "enum": [
                  "SPECIFICATION_ASSESSMENT",
                  "PLAN_ASSESSMENT",
                  "AGENT_EXECUTION",
                  "INDEPENDENT_VERIFICATION",
                  "RELEASE_READINESS"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "error_id",
          "code",
          "message",
          "occurred_at",
          "retryable",
          "blocked_gate",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "workflow_id",
    "report_id",
    "gate_name",
    "input_hash",
    "report_hash",
    "hash_method",
    "assessor_version",
    "status",
    "attempt",
    "generated_at",
    "requirement_links",
    "checklist",
    "evidence",
    "findings",
    "errors"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_name": {
            "const": "PLAN_ASSESSMENT"
          }
        },
        "required": [
          "gate_name"
        ]
      },
      "then": {},
      "else": {
        "not": {
          "properties": {
            "status": {
              "const": "READY"
            }
          },
          "required": [
            "status"
          ]
        }
      }
    }
  ]
}
